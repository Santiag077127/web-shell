# Fuente de datos de sesion.
# mock = fixtures quemados para validar UX/UI mientras no exista iam-service en develop.
# http = GET /auth/me y POST /auth/logout reales.
VITE_SESSION_SOURCE=http
VITE_LOCAL_SESSION=true

# Fuente de los remotes del shell.
# mock = stubs por dominio, permite ver el chrome sin construir los 9 MFE.
# federation = lazy() real contra las URLs de remotes.<env>.json.
VITE_REMOTE_SOURCE=federation

# Fuente de notificaciones del shell.
# http = GET /notifications/{id} contra el BFF/edge local via /api/v1.
VITE_NOTIFICATION_SOURCE=http
